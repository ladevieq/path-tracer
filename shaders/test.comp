#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_descriptor_heap : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(descriptor_heap) uniform texture2D textures[];
layout(descriptor_heap, rgba32f) uniform image2D images[];
layout(descriptor_heap) uniform sampler samplers[];


layout(push_constant) uniform buffers {
    uint input_id1;
    uint input_id2;
    uint output_id;
    uint pad;
} regs;

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    float t = 0.5;
    vec3 color_1 = imageLoad(images[nonuniformEXT(regs.input_id1)], coords).xyz;
    vec3 color_2 = imageLoad(images[nonuniformEXT(regs.input_id2)], coords).xyz;
    vec3 out_color = (t * color_1) + ((1.0 - t) * color_2);

    imageStore(images[nonuniformEXT(regs.output_id)], coords, vec4(out_color, 1.0));
}
